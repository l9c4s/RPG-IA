{
  "permissions": {
    "allow": [
      "Bash(git:*)",
      "Bash(find:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(mkdir:*)",
      "Write(*)",
      "Read(*)",
      "Glob(*)",
      "Grep(*)"
    ],
    "defaultMode": "acceptEdits"
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"c:/Users/crazy mam/Desktop/RPG-IA/scripts/generate-tests.sh\"",
            "timeout": 180,
            "statusMessage": "Generating tests for changed files…"
          }
        ]
      }
    ]
  }
}
