# PostgreSQL
POSTGRES_USER=rpg_user
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=rpg_platform

# MinIO
MINIO_ACCESS_KEY=minio_access_key
MINIO_SECRET_KEY=minio_secret_key_change_me

# OpenAI (LLM + embeddings + DALL·E 3)
OPENAI_API_KEY=sk-...

# ElevenLabs (TTS) — vozes dinâmicas por contexto narrativo
ELEVENLABS_API_KEY=

# Narração e exploração
VOICE_NARRATOR_ID=    # narração neutra, mundo aberto
VOICE_MYSTERY_ID=     # dungeons, horror, revelações — instável (herda narrator se vazio)
VOICE_DEATH_ID=       # morte, lamento, peso emocional (herda narrator se vazio)

# Ação
VOICE_COMBAT_ID=      # combate ativo, perigo — intenso e acelerado
VOICE_EPIC_ID=        # clímax épico, momentos de virada
VOICE_TRIUMPH_ID=     # vitória, celebração

# NPCs
VOICE_TAVERN_ID=      # NPCs comuns, tavernas, conversas
VOICE_SAGE_ID=        # sábios, anciões, divindades
VOICE_VILLAIN_ID=     # antagonistas — frio e perturbador
VOICE_CREATURE_ID=    # monstros, entidades — caótico

# Aliases legado (ainda funcionam como fallback)
GM_VOICE_ID=          # equivale a VOICE_NARRATOR_ID se definido
NPC_VOICE_ID=         # fallback para VOICE_TAVERN_ID
VILLAIN_VOICE_ID=     # fallback para VOICE_VILLAIN_ID

# Auth
JWT_SECRET=change_me_at_least_32_random_chars_here

# Domínio (nginx SSL)
DOMAIN=yourdomain.com

# Redis
REDIS_URL=redis://redis:6379/0

# Internal service URLs
GATEWAY_URL=http://gateway:8000
PDF_SERVICE_URL=http://pdf_service:8001
CAMPAIGN_SERVICE_URL=http://campaign_service:8002
CHARACTER_SERVICE_URL=http://character_service:8003
IMAGE_SERVICE_URL=http://image_service:8004
TTS_SERVICE_URL=http://tts_service:8005
MINIO_ENDPOINT=minio:9000
